rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userDoc() { return get(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && userDoc().data.role == 'admin' && userDoc().data.active == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      allow create: if isAdmin() || (isSelf(uid) && request.resource.data.role == 'admin' && request.resource.data.username == 'admin');
      allow update: if isAdmin() || isSelf(uid);
      allow delete: if isAdmin();
    }

    match /directory/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin() || isSelf(uid);
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /lessons/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /substitutions/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.substituteTeacherId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.substituteTeacherId == request.auth.uid && resource.data.status == 'pending');
    }

    match /attendance/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
