rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if signedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.auth.token.email == 'admin@auth.absensipro.local'
        && request.resource.data.role == 'admin';
      allow update, delete: if isAdmin();
    }

    match /directory/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{document} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /substitutions/{substitutionId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.substituteTeacherId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin()
        || (signedIn() && request.resource.data.userId == request.auth.uid);
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
